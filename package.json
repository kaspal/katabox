{
  "name": "katabox",
  "private": true,
  "license": "MIT OR Apache-2.0",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "pnpm --filter @katabox/desktop tauri dev",
    "build": "pnpm --filter @katabox/desktop build",
    "typecheck": "pnpm --filter @katabox/desktop exec tsc --noEmit",
    "test": "pnpm --filter @katabox/desktop test",
    "licenses:check": "node scripts/check-npm-licenses.mjs",
    "notices": "node scripts/gen-notices.mjs",
    "installer-art": "node scripts/gen-installer-art.mjs",
    "tauri": "pnpm --filter @katabox/desktop tauri",
    "release:build": "pnpm notices && pnpm --filter @katabox/desktop tauri build"
  }
}
