# Generated by KataBox: runs the tests for {{ function }}(). Do not edit.
#
# Protocol (ADR 0008): stdin is {"nonce", "max_output_bytes", "tests": [{param: value}]}.
# Every record goes to the real stdout as "\n<nonce> <json>\n"; anything else on stdout
# is ignored. The user's prints are captured per test, never mixed with records.
import importlib.util
import io
import json
import os
import sys
import time
import traceback

SOLUTION = {{ solution_file | tojson }}
FUNCTION = {{ function | tojson }}
ALIASES = {{ aliases | tojson }}
PARAMS = {{ param_keys | tojson }}


class Capture(io.TextIOBase):
    """Stands in for sys.stdout/sys.stderr during a test; keeps up to `cap` characters."""

    def __init__(self, cap):
        self.cap = cap
        self.parts = []
        self.size = 0
        self.truncated = False

    def writable(self):
        return True

    def write(self, s):
        if not isinstance(s, str):
            raise TypeError("write() argument must be str, not " + type(s).__name__)
        n = len(s)
        room = self.cap - self.size
        if n > room:
            self.truncated = True
            s = s[: max(room, 0)]
        if s:
            self.parts.append(s)
            self.size += len(s)
        return n

    def text(self):
        return "".join(self.parts)


def user_traceback(e):
    """The traceback from the first frame in the user's file (harness frames dropped)."""
    tb = e.__traceback__
    while tb is not None and os.path.basename(tb.tb_frame.f_code.co_filename) != SOLUTION:
        tb = tb.tb_next
    return "".join(traceback.format_exception(type(e), e, tb or e.__traceback__))


def main():
    out, err = sys.stdout, sys.stderr
    request = json.loads(sys.stdin.buffer.read())
    nonce = request["nonce"]
    cap = request["max_output_bytes"]

    def emit(record):
        out.write("\n" + nonce + " " + json.dumps(record) + "\n")
        out.flush()

    sys.dont_write_bytecode = True
    sys.setrecursionlimit(max(sys.getrecursionlimit(), 10_000))

    # Prints while the module loads are discarded.
    sys.stdout = sys.stderr = Capture(0)
    try:
        spec = importlib.util.spec_from_file_location("solution", SOLUTION)
        module = importlib.util.module_from_spec(spec)
        sys.modules["solution"] = module
        spec.loader.exec_module(module)
    except SyntaxError as e:  # includes IndentationError and TabError
        emit({
            "kind": "compile_error",
            "code": "syntax_error",
            "message": "".join(traceback.format_exception_only(e)),
        })
        return
    except BaseException as e:
        emit({"kind": "load_error", "message": user_traceback(e)})
        return
    finally:
        sys.stdout, sys.stderr = out, err

    fn = next((f for f in (getattr(module, a, None) for a in ALIASES) if callable(f)), None)
    if fn is None:
        emit({
            "kind": "compile_error",
            "code": "function_not_found",
            "message": "function " + FUNCTION + "() is not defined",
        })
        return

    emit({"kind": "ready"})
    for i, test in enumerate(request["tests"]):
        args = [test[p] for p in PARAMS]
        capture = Capture(cap)
        record = {"kind": "result", "test": i}
        sys.stdout = sys.stderr = capture
        start = time.perf_counter_ns()
        try:
            record["value"] = fn(*args)
            record["status"] = "ok"
        except MemoryError:
            record["status"] = "memory"
        except BaseException as e:
            record["status"] = "error"
            record["error_code"] = "exception"
            record["error"] = user_traceback(e)
        finally:
            elapsed = time.perf_counter_ns() - start
            sys.stdout, sys.stderr = out, err
        record["time_us"] = elapsed // 1000
        record["stdout"] = capture.text()
        record["stdout_truncated"] = capture.truncated
        try:
            line = json.dumps(record, allow_nan=False)
        except Exception as e:
            record.pop("value", None)
            record["status"] = "error"
            record["error_code"] = "return_not_serializable"
            record["error"] = "return value cannot be converted to JSON: " + repr(e)
            line = json.dumps(record)
        out.write("\n" + nonce + " " + line + "\n")
        out.flush()
    emit({"kind": "done"})


if __name__ == "__main__":
    main()
    sys.stdout.flush()
    # Do not wait for threads the solution may have left running.
    os._exit(0)
