# Generated by KataBox: replays {{ function }}() for the debugger (ADR 0022). Do not edit.
#
# Request on stdin: {"nonce", "max_output_bytes", "trace_budget", "input": {param: value},
# "mode": "trace" | "stop", "max_steps", "step", "frame", "expand": [[scope, name, i...]],
# "evals": [expr], "visualize": [name] (optional)}. Records go to the real stdout as "\n<nonce> <json>\n" (ADR 0008).
#
# A step is a LINE event in the user's file (sys.monitoring, PEP 669; every other file is
# disabled at its first event, so harness and library frames are invisible). "trace"
# runs the test once and records each step's line and user-frame depth. "stop" replays
# to one step, describes the frames there and exits at once: nothing after it runs, and
# evaluations never reach a later step.
import array
import builtins
import collections
import importlib.util
import io
import json
import os
import random
import sys
import threading
import traceback

SOLUTION = {{ solution_file | tojson }}
FUNCTION = {{ function | tojson }}
ALIASES = {{ aliases | tojson }}
PARAMS = {{ param_keys | tojson }}
{% if uses_nodes %}
PARAM_SHAPES = {{ param_shapes | tojson }}
RETURN_SHAPE = {{ return_shape | tojson }}


{{ nodes_code }}
{% endif %}

M = sys.monitoring
TOOL = M.DEBUGGER_ID
E = M.events
MASK = (1 << 64) - 1
FNV_OFFSET = 0xCBF29CE484222325
FNV_PRIME = 0x100000001B3
# Trace tokens: each distinct (line, depth) pair gets a code; a step is one character
# for the first 91 codes, or "~" plus two characters after that. The alphabet is printable
# ASCII without '"', '\\' and '~', so JSON never escapes it.
ALPHABET = "".join(chr(c) for c in range(33, 126) if chr(c) not in '"\\~')
MAX_CODES = len(ALPHABET) + len(ALPHABET) ** 2
REPR_MAX = 200
CHILDREN_MAX = 100
EVAL_MAX = 2000

# --- The visualizer's snapshot (ADR 0027) ---------------------------------------------
# A bounded, structured copy of the requested variables, taken at the stop just before
# the process exits. It never runs user code: only exact built-in containers and
# ListNode / TreeNode instance fields are followed (read through object.__getattribute__,
# never getattr), scalars are formatted here, everything else is its type name. The
# built-ins it uses are saved now, before the solution loads, so a solution that patches
# builtins or collections cannot change what the snapshot sees.
SNAP_MAX_OBJECTS = 1000
SNAP_MAX_ITEMS = 500
SNAP_MAX_VALUES = 10_000
# Estimated JSON bytes: past this the snapshot is cut (truncated), well before the hard cap.
SNAP_SOFT_BYTES = 200_000
SNAP_MAX_DEPTH = 32
SNAP_MAX_STR = 64
SNAP_MAX_NAMES = 16
SNAP_MAX_BYTES = 256 * 1024
_ID = builtins.id
_TYPE = builtins.type
_LEN = builtins.len
_STR = builtins.str
_INT = builtins.int
_FLOAT = builtins.float
_BOOL = builtins.bool
_LIST = builtins.list
_TUPLE = builtins.tuple
_DICT = builtins.dict
_SET = builtins.set
_FROZENSET = builtins.frozenset
_NONE = builtins.type(None)
_DEQUE = collections.deque
# array.array (typed numbers) is drawn as a list, marked `typed`.
_ARRAY = array.array
_DEFAULTDICT = collections.defaultdict
_COUNTER = collections.Counter
_ORDEREDDICT = collections.OrderedDict
_OBJ_GET = builtins.object.__getattribute__
_TYPE_GET = builtins.type.__getattribute__
_DICT_ITEMS = builtins.dict.items
_DICT_GET = builtins.dict.get
_LIST_APPEND = builtins.list.append
_OD_ITEMS = collections.OrderedDict.items
_INT_STR = builtins.int.__repr__
_INT_BITS = builtins.int.bit_length
_FLOAT_REPR = builtins.float.__repr__
_DUMPS = json.dumps
_SNAP_LISTS = (_LIST, _TUPLE, _DEQUE, _ARRAY)
_SNAP_MAPS = (_DICT, _DEFAULTDICT, _COUNTER, _ORDEREDDICT)
_SNAP_SETS = (_SET, _FROZENSET)
# Input nodes, numbered when the harness builds them (identity across steps).
INPUT_IDS = {}
INPUT_KEEP = []


class CaptureBuffer:
    """`sys.stdout.buffer` for a program that writes bytes (decoded as UTF-8)."""

    def __init__(self, text):
        self.text = text

    def write(self, b):
        self.text.write(bytes(b).decode("utf-8", "replace"))
        return len(b)

    def flush(self):
        pass


class StepCapture(io.TextIOBase):
    """The user's prints while tracing, each chunk tagged with the step it happened at."""

    def __init__(self, cap, state):
        self.cap = cap
        self.state = state
        self.chunks = []
        self.size = 0
        self.truncated = False
        self.buffer = CaptureBuffer(self)

    def writable(self):
        return True

    def write(self, s):
        if not isinstance(s, str):
            raise TypeError("write() argument must be str, not " + type(s).__name__)
        n = len(s)
        room = self.cap - self.size
        if n > room:
            self.truncated = True
            s = s[: max(room, 0)]
        if s:
            step = max(self.state.steps - 1, 0)
            if self.chunks and self.chunks[-1][0] == step:
                self.chunks[-1][1] += s
            else:
                self.chunks.append([step, s])
            self.size += len(s)
        return n


class State:
    def __init__(self, request):
        self.mode = request["mode"]
        self.max_steps = request.get("max_steps", 200_000)
        self.budget = request.get("trace_budget", 1 << 20)
        self.target = request.get("step", 0)
        self.request = request
        self.steps = 0
        self.depth = 0
        self.hash = FNV_OFFSET
        self.codes = {}
        self.table = []
        self.tokens = []
        self.token_bytes = 0
        self.truncated = None
        self.user = {}


def is_user(state, code):
    known = state.user.get(code)
    if known is None:
        known = os.path.basename(code.co_filename) == SOLUTION
        state.user[code] = known
    return known


NODE_PREVIEW = 10


def node_kind(value):
    """"list" or "tree" for a ListNode / TreeNode instance (ADR 0025), else None."""
    name = type(value).__name__
    try:
        if name == "ListNode" and hasattr(value, "val") and hasattr(value, "next"):
            return "list"
        if name == "TreeNode" and all(hasattr(value, a) for a in ("val", "left", "right")):
            return "tree"
    except BaseException:
        pass
    return None


def node_repr(value, kind):
    """A short, cycle-safe line for a node: never the whole chain, never an address."""
    def val(node):
        if node is None:
            return "None"
        v = getattr(node, "val", None)
        text = repr(v) if isinstance(v, (int, float, str, bool)) or v is None else "…"
        return text if len(text) <= 20 else text[:19] + "…"

    if kind == "tree":
        return "TreeNode(%s, left=%s, right=%s)" % (val(value), val(value.left), val(value.right))
    parts, seen, node = [], set(), value
    while node is not None and len(parts) < NODE_PREVIEW:
        if id(node) in seen:
            parts.append("↺")
            break
        seen.add(id(node))
        parts.append(val(node))
        node = getattr(node, "next", None)
    else:
        if node is not None:
            parts.append("…")
    return "ListNode [" + " → ".join(parts) + "]"


def short_repr(value):
    kind = node_kind(value)
    if kind is not None:
        try:
            return node_repr(value, kind)
        except BaseException:
            pass
    try:
        text = repr(value)
    except BaseException as e:  # a user __repr__ may raise
        text = "<repr failed: " + type(e).__name__ + ">"
    if len(text) > REPR_MAX:
        text = text[: REPR_MAX - 1] + "…"
    return text


def children(value):
    """(name, child) pairs of a container or plain object, in a stable order."""
    if isinstance(value, (str, bytes, int, float, complex, bool)) or value is None:
        return []
    if isinstance(value, dict):
        return [(short_repr(k), v) for k, v in value.items()]
    if isinstance(value, (list, tuple)):
        return [("[" + str(i) + "]", v) for i, v in enumerate(value)]
    if isinstance(value, (set, frozenset)):
        return [("", v) for v in value]
    if isinstance(value, type) or type(value).__name__ in ("module", "function", "method"):
        return []
    kind = node_kind(value)
    if kind == "list":
        return [("val", value.val), ("next", value.next)]
    if kind == "tree":
        return [("val", value.val), ("left", value.left), ("right", value.right)]
    attrs = getattr(value, "__dict__", None)
    if isinstance(attrs, dict):
        return [(k, attrs[k]) for k in sorted(attrs) if not k.startswith("__")]
    return []


def count_children(value):
    try:
        if isinstance(value, (dict, list, tuple, set, frozenset)):
            return len(value)
        return len(children(value))
    except BaseException:
        return 0


def describe(name, value):
    return {
        "name": name,
        "type": type(value).__name__,
        "value": short_repr(value),
        "children": count_children(value),
    }


def visible_globals(frame):
    out = []
    for name, value in frame.f_globals.items():
        if name.startswith("__") or name in ALIASES:
            continue
        if isinstance(value, type) or type(value).__name__ in (
            "module", "function", "builtin_function_or_method", "method",
        ):
            continue
        if getattr(value, "__module__", None) == "typing":
            continue
        out.append((name, value))
    return out


def user_frames(state, frame):
    frames = []
    while frame is not None:
        if is_user(state, frame.f_code):
            frames.append(frame)
        frame = frame.f_back
    return frames


def scope_items(frame, scope):
    if frame.f_code.co_name == "<module>":
        # A program's module frame (ADR 0028): its globals are its variables, shown once.
        return visible_globals(frame) if scope == "locals" else []
    if scope == "locals":
        return list(frame.f_locals.items())
    return visible_globals(frame)


def expand(frame, path):
    """Children of the value at path = [scope, name, i, j, ...] (positions in children())."""
    scope, name, rest = path[0], path[1], path[2:]
    value = dict(scope_items(frame, scope))[name]
    for i in rest:
        value = children(value)[i][1]
    kids = children(value)
    return {
        "path": path,
        "children": [describe(n, v) for n, v in kids[:CHILDREN_MAX]],
        "more": max(len(kids) - CHILDREN_MAX, 0),
    }


def evaluate(frame, expr):
    out = io.StringIO()
    real = sys.stdout, sys.stderr
    sys.stdout = sys.stderr = out
    try:
        try:
            code = compile(expr, "<console>", "eval")
            value = eval(code, frame.f_globals, frame.f_locals)
            result = {"expr": expr, "ok": True, "value": describe("", value)}
        except SyntaxError:
            exec(compile(expr, "<console>", "exec"), frame.f_globals, frame.f_locals)
            result = {"expr": expr, "ok": True, "value": None}
    except BaseException as e:
        result = {"expr": expr, "ok": False, "error": "".join(traceback.format_exception_only(e)).strip()}
    finally:
        sys.stdout, sys.stderr = real
    result["stdout"] = out.getvalue()[:EVAL_MAX]
    return result


def snap_type_name(value):
    try:
        name = _TYPE_GET(_TYPE(value), "__name__")
        return name if _TYPE(name) is _STR else "object"
    except BaseException:
        return "object"


def snap_node(value):
    """("list" | "tree", the instance __dict__) for a ListNode / TreeNode, else None."""
    name = snap_type_name(value)
    if name != "ListNode" and name != "TreeNode":
        return None
    try:
        fields = _OBJ_GET(value, "__dict__")
    except BaseException:
        return None  # __slots__ or no instance dict: shown as its type name
    if _TYPE(fields) is not _DICT:
        return None
    want = ("val", "next") if name == "ListNode" else ("val", "left", "right")
    for k in want:
        if _DICT_GET(fields, k, fields) is fields:
            return None
    return ("list" if name == "ListNode" else "tree"), fields


def number_inputs(args):
    """Number the ListNode / TreeNode instances the harness built for the input, in a
    fixed walk of the arguments, and keep them alive (an address is never reused)."""
    queue, k = _LIST(args), 0
    while k < _LEN(queue):
        value = queue[k]
        k += 1
        if _TYPE(value) is _LIST:
            for item in value:
                _LIST_APPEND(queue, item)
            continue
        node = snap_node(value)
        if node is None or _DICT_GET(INPUT_IDS, _ID(value)) is not None:
            continue
        INPUT_IDS[_ID(value)] = _LEN(INPUT_KEEP)
        _LIST_APPEND(INPUT_KEEP, value)
        kind, fields = node
        for key in ("next",) if kind == "list" else ("left", "right"):
            _LIST_APPEND(queue, fields[key])


def snap_scalar(value):
    t = _TYPE(value)
    if t is _BOOL:
        return {"t": "bool", "v": "True" if value else "False"}
    if t is _INT:
        bits = _INT_BITS(value)
        if bits > 13_000:  # beyond str()'s 4300-digit limit
            return {"t": "int", "v": ("-" if value < 0 else "") + "≈2^" + _INT_STR(bits)}
        text = _INT_STR(value)
        if _LEN(text) > SNAP_MAX_STR:
            text = text[:20] + "… (" + _INT_STR(_LEN(text) - (value < 0)) + " digits)"
        return {"t": "int", "v": text}
    if t is _FLOAT:
        return {"t": "float", "v": _FLOAT_REPR(value)}
    if t is _STR:
        text = value if _LEN(value) <= SNAP_MAX_STR else value[: SNAP_MAX_STR - 1] + "…"
        return {"t": "str", "v": text}
    if t is _NONE:
        return {"t": "none", "v": "None"}
    return None


def snapshot(frame, names):
    """The visualizer's snapshot of `names` in `frame` (ADR 0027)."""
    objects, ids, queue = [], {}, []
    snap = {"roots": [], "objects": objects, "truncated": False}
    budget = [SNAP_MAX_VALUES]
    size = [0]

    def full():
        return budget[0] <= 0 or size[0] > SNAP_SOFT_BYTES

    def value_of(value, depth):
        size[0] += 24
        scalar = snap_scalar(value)
        if scalar is not None:
            size[0] += _LEN(scalar["v"])
            return scalar
        t = _TYPE(value)
        node = None
        if t not in _SNAP_LISTS and t not in _SNAP_MAPS and t not in _SNAP_SETS:
            node = snap_node(value)
            if node is None:
                return {"t": "opaque", "v": snap_type_name(value)}
        key = _ID(value)
        known = _DICT_GET(ids, key)
        if known is not None:
            return {"t": "ref", "id": known}
        if _LEN(objects) >= SNAP_MAX_OBJECTS or depth >= SNAP_MAX_DEPTH:
            snap["truncated"] = True
            return {"t": "opaque", "v": snap_type_name(value)}
        index = _LEN(objects)
        size[0] += 48
        ids[key] = index
        _LIST_APPEND(objects, None)
        _LIST_APPEND(queue, (value, node, index, depth))
        return {"t": "ref", "id": index}

    def fill(value, node, index, depth):
        t = _TYPE(value)
        if node is not None:
            kind, fields = node
            budget[0] -= 1
            obj = {
                "kind": "list_node" if kind == "list" else "tree_node",
                "val": value_of(fields["val"], depth + 1),
            }
            for k in ("next",) if kind == "list" else ("left", "right"):
                obj[k] = value_of(fields[k], depth + 1)
            number = _DICT_GET(INPUT_IDS, _ID(value))
            if number is not None:
                obj["input"] = number
        elif t in _SNAP_MAPS:
            entries = []
            pairs = _OD_ITEMS(value) if t is _ORDEREDDICT else _DICT_ITEMS(value)
            for k, v in pairs:
                if _LEN(entries) >= SNAP_MAX_ITEMS or budget[0] <= 1 or full():
                    snap["truncated"] = True
                    break
                budget[0] -= 2
                _LIST_APPEND(entries, [value_of(k, depth + 1), value_of(v, depth + 1)])
            obj = {"kind": "map", "type": snap_type_name(value), "entries": entries, "len": _LEN(value)}
        else:
            items = []
            for v in value:
                if _LEN(items) >= SNAP_MAX_ITEMS or full():
                    snap["truncated"] = True
                    break
                budget[0] -= 1
                _LIST_APPEND(items, value_of(v, depth + 1))
            kind = "set" if t in _SNAP_SETS else "list"
            obj = {"kind": kind, "type": snap_type_name(value), "items": items, "len": _LEN(value)}
            if t is _ARRAY:
                obj["typed"] = True
        objects[index] = obj

    try:
        if frame.f_code.co_name == "<module>":
            local_items = _LIST(visible_globals(frame))
        else:
            local_items = _LIST(_DICT_ITEMS(_DICT(frame.f_locals)))
        scopes = [_DICT(local_items), _DICT(visible_globals(frame))]
        chosen = []
        for name in _LIST(names)[:SNAP_MAX_NAMES]:
            if _TYPE(name) is not _STR or name in chosen:
                continue
            for scope in scopes:
                if name in scope:
                    _LIST_APPEND(chosen, name)
                    _LIST_APPEND(snap["roots"], {"name": name, "value": value_of(scope[name], 0)})
                    break
        # Every other local holding a node, so pointers like slow / fast are labelled.
        for name, value in local_items:
            if name not in chosen and _TYPE(name) is _STR and snap_node(value) is not None:
                _LIST_APPEND(snap["roots"], {"name": name, "value": value_of(value, 0)})
        k = 0
        while k < _LEN(queue):
            fill(*queue[k])
            k += 1
        if _LEN(_DUMPS(snap, allow_nan=False, separators=(",", ":"))) > SNAP_MAX_BYTES:
            return {"roots": [], "objects": [], "truncated": True, "error": "too_large"}
        return snap
    except BaseException as e:
        return {"roots": [], "objects": [], "truncated": True, "error": "snapshot failed: " + snap_type_name(e)}


def describe_stop(state, frame):
    """Everything the debugger shows at the stop: stack, variables, expansions, evals."""
    frames = user_frames(state, frame)
    req = state.request
    index = min(max(req.get("frame", 0), 0), len(frames) - 1)
    chosen = frames[index]
    record = {
        "kind": "stop",
        "step": state.target,
        "hash": state.hash,
        "stack": [
            {"function": f.f_code.co_qualname, "line": f.f_lineno} for f in frames
        ],
        "frame": index,
        "locals": [describe(n, v) for n, v in scope_items(chosen, "locals")],
        "globals": [describe(n, v) for n, v in scope_items(chosen, "globals")],
        "expanded": [],
        "evals": [],
    }
    for path in req.get("expand", []):
        try:
            record["expanded"].append(expand(chosen, path))
        except (KeyError, IndexError, TypeError):
            record["expanded"].append({"path": path, "children": [], "more": 0})
    for expr in req.get("evals", []):
        record["evals"].append(evaluate(chosen, expr))
    if req.get("visualize") is not None:
        # After the evaluations: the snapshot shows the state the Variables view shows.
        record["snapshot"] = snapshot(chosen, req["visualize"])
    return record


def main():
    out = sys.stdout
    request = json.loads(sys.stdin.buffer.read())
    nonce = request["nonce"]

    def emit(record):
        out.write("\n" + nonce + " " + json.dumps(record, allow_nan=False) + "\n")
        out.flush()

    def finish(record):
        emit(record)
        os._exit(0)

    sys.dont_write_bytecode = True
    sys.setrecursionlimit(max(sys.getrecursionlimit(), 10_000))
    random.seed(0)

{% if program %}
    # A program problem (ADR 0028): the solution is the whole program, run below as
    # __main__ with every step traced. A syntax error is a load error, as for a function.
    try:
        with open(SOLUTION, "rb") as f:
            compile(f.read(), SOLUTION, "exec")
        spec = importlib.util.spec_from_file_location("__main__", SOLUTION)
        module = importlib.util.module_from_spec(spec)
    except BaseException as e:
        finish({"kind": "load_error", "message": "".join(traceback.format_exception_only(e))})
    # The test's stdin on fd 0 (kb-judge writes stdin.txt next to this file), so input(),
    # sys.stdin.read(), sys.stdin.buffer and open(0) all read it.
    fd = os.open("stdin.txt", os.O_RDONLY)
    os.dup2(fd, 0)
    os.close(fd)
    sys.stdin = open(0, "r", encoding="utf-8", closefd=False)
{% else %}
    sys.stdout = sys.stderr = io.StringIO()
    try:
        spec = importlib.util.spec_from_file_location("solution", SOLUTION)
        module = importlib.util.module_from_spec(spec)
        sys.modules["solution"] = module
        spec.loader.exec_module(module)
    except BaseException as e:
        sys.stdout, sys.stderr = out, sys.__stderr__
        finish({"kind": "load_error", "message": "".join(traceback.format_exception(e))})
    sys.stdout, sys.stderr = out, sys.__stderr__
    fn = next((f for f in (getattr(module, a, None) for a in ALIASES) if callable(f)), None)
    if fn is None:
        finish({"kind": "load_error", "message": "function " + FUNCTION + "() is not defined"})
{% endif %}

    state = State(request)

    def trace_record():
        return {
            "kind": "trace",
            "table": state.table,
            "tokens": "".join(state.tokens),
            "steps": state.steps,
            "truncated": state.truncated,
            "prints": capture.chunks,
            "prints_truncated": capture.truncated,
        }

    def on_line(code, line):
        if not is_user(state, code):
            return M.DISABLE
        if state.mode == "stop":
            # FNV-1a over (line, depth) of every step so far: kb-judge computes the same
            # value from the trace to check that this replay went the same way.
            state.hash = ((state.hash ^ line) * FNV_PRIME) & MASK
            state.hash = ((state.hash ^ state.depth) * FNV_PRIME) & MASK
            if state.steps == state.target:
                M.set_events(TOOL, 0)
                sys.stdout, sys.stderr = out, sys.__stderr__
                finish(describe_stop(state, sys._getframe(1)))
            state.steps += 1
            return None
        pair = (line, state.depth)
        code_index = state.codes.get(pair)
        if code_index is None:
            code_index = len(state.table)
            if code_index >= MAX_CODES:
                state.truncated = "codes"
            else:
                state.codes[pair] = code_index
                state.table.append([line, state.depth])
        if state.truncated is None:
            if code_index < len(ALPHABET):
                token = ALPHABET[code_index]
            else:
                hi, lo = divmod(code_index - len(ALPHABET), len(ALPHABET))
                token = "~" + ALPHABET[hi] + ALPHABET[lo]
            if state.steps >= state.max_steps:
                state.truncated = "steps"
            elif state.token_bytes + len(token) > state.budget:
                state.truncated = "bytes"
        if state.truncated is not None:
            M.set_events(TOOL, 0)
            sys.stdout, sys.stderr = out, sys.__stderr__
            finish(trace_record())
        state.tokens.append(token)
        state.token_bytes += len(token)
        state.steps += 1
        return None

    def on_enter(code, offset, *rest):
        if not is_user(state, code):
            return M.DISABLE
        state.depth += 1
        return None

    def on_leave(code, offset, *rest):
        if not is_user(state, code):
            return M.DISABLE
        state.depth -= 1
        return None

    def on_unwind(code, offset, exc):
        # PY_UNWIND and PY_THROW cannot be disabled; ignore other files.
        if is_user(state, code):
            state.depth -= 1

    def on_throw(code, offset, exc):
        if is_user(state, code):
            state.depth += 1

    M.use_tool_id(TOOL, "katabox")
    M.register_callback(TOOL, E.LINE, on_line)
    M.register_callback(TOOL, E.PY_START, on_enter)
    M.register_callback(TOOL, E.PY_RESUME, on_enter)
    M.register_callback(TOOL, E.PY_RETURN, on_leave)
    M.register_callback(TOOL, E.PY_YIELD, on_leave)
    M.register_callback(TOOL, E.PY_UNWIND, on_unwind)
    M.register_callback(TOOL, E.PY_THROW, on_throw)

{% if program %}
{% elif uses_nodes %}
    classes = node_classes(module)
    args = [from_json(*PARAM_SHAPES[k], request["input"][p], classes) for k, p in enumerate(PARAMS)]
    if request.get("visualize") is not None:
        number_inputs(args)
{% else %}
    args = [request["input"][p] for p in PARAMS]
{% endif %}
    capture = StepCapture(request["max_output_bytes"], state)
    if state.mode == "stop":
        capture.cap = 0
    sys.stdout = sys.stderr = capture
    outcome = {"kind": "outcome"}
    M.set_events(
        TOOL,
        E.LINE | E.PY_START | E.PY_RESUME | E.PY_RETURN | E.PY_YIELD | E.PY_UNWIND | E.PY_THROW,
    )
    try:
{% if program %}
        sys.modules["__main__"] = module
        spec.loader.exec_module(module)
        # A program may finish its work in threads it started (the stack-size idiom).
        for t in threading.enumerate():
            if t is not threading.main_thread() and not t.daemon:
                t.join()
        outcome["status"] = "ok"
        outcome["value"] = None
{% else %}
        value = fn(*args)
        outcome["status"] = "ok"
        outcome["value"] = value
{% endif %}
    except MemoryError:
        outcome["status"] = "memory"
{% if program %}
    except SystemExit as e:
        # sys.exit() or sys.exit(0) ends a program normally; another code is an error.
        if e.code is None or e.code == 0:
            outcome["status"] = "ok"
            outcome["value"] = None
        else:
            outcome["status"] = "error"
            outcome["error"] = "SystemExit: " + str(e.code)
            outcome["line"] = None
{% endif %}
    except BaseException as e:
        outcome["status"] = "error"
        tb = e.__traceback__
        while tb is not None and os.path.basename(tb.tb_frame.f_code.co_filename) != SOLUTION:
            tb = tb.tb_next
        outcome["error"] = "".join(traceback.format_exception(type(e), e, tb or e.__traceback__))
        last = tb
        while last is not None and last.tb_next is not None:
            last = last.tb_next
        outcome["line"] = last.tb_lineno if last is not None else None
    finally:
        M.set_events(TOOL, 0)
        sys.stdout, sys.stderr = out, sys.__stderr__
    outcome["step"] = max(state.steps - 1, 0)
{% if uses_nodes %}
    if outcome.get("status") == "ok":
        try:
            outcome["value"] = to_json(*RETURN_SHAPE, outcome["value"])
        except Exception as e:
            outcome.pop("value")
            outcome["status"] = "error"
            outcome["error"] = str(e) if isinstance(e, NodeError) else "return value is not a " + {{ returns_raw | tojson }} + ": " + repr(e)
{% endif %}

    if state.mode == "stop":
        # The program ended before the requested step: this run went another way.
        finish({"kind": "diverged", "steps": state.steps})
    record = trace_record()
    record["truncated"] = None
    try:
        line = json.dumps(record, allow_nan=False)
        out.write("\n" + nonce + " " + line + "\n")
    except Exception:
        finish({"kind": "load_error", "message": "the trace could not be written"})
    try:
        line = json.dumps(outcome, allow_nan=False)
    except Exception as e:
        outcome.pop("value", None)
        outcome["status"] = "error"
        outcome["error"] = "return value cannot be converted to JSON: " + repr(e)
        line = json.dumps(outcome)
    out.write("\n" + nonce + " " + line + "\n")
    out.flush()
    os._exit(0)


if __name__ == "__main__":
    main()
