// Generated by KataBox: runs the tests for {{ function }}(). Do not edit.
//
// Protocol (ADR 0008): stdin is {"nonce", "max_output_bytes", "tests": [{param: value}]}.
// Every record goes to fd 1 as "\n<nonce> <json>\n"; anything else on stdout is ignored.
// The user's console output is captured per test, never mixed with records.
import { readFileSync, writeSync } from "node:fs";

const SOLUTION: string = {{ solution_file | tojson }};
const FUNCTION: string = {{ function | tojson }};
const PARAMS: string[] = {{ param_keys | tojson }};
{% if uses_nodes %}
const PARAM_SHAPES: [string, number][] = {{ param_shapes | tojson }};
const RETURN_SHAPE: [string, number] = {{ return_shape | tojson }};

{{ nodes_code }}
{% endif %}

type Rec = Record<string, unknown>;

const request = JSON.parse(readFileSync(0, "utf8"));
const nonce: string = request.nonce;
const cap: number = request.max_output_bytes;

function emitLine(line: string): void {
  writeSync(1, "\n" + nonce + " " + line + "\n");
}

function emit(rec: Rec): void {
  emitLine(JSON.stringify(rec));
}

/** Collects console output for one test, up to `cap` characters. */
class Capture {
  text = "";
  truncated = false;
  readonly cap: number;
  // No parameter properties: Node's type stripping does not support them.
  constructor(cap: number) {
    this.cap = cap;
  }
  add(s: string): void {
    const room = this.cap - this.text.length;
    if (s.length > room) {
      this.truncated = true;
      s = s.slice(0, Math.max(room, 0));
    }
    this.text += s;
  }
}

// console.* and process.std{out,err}.write all land here; output outside a test
// (capture === null) is discarded. Records bypass this through writeSync.
let capture: Capture | null = null;
function hookedWrite(chunk: unknown, ...rest: unknown[]): boolean {
  if (capture !== null) {
    capture.add(typeof chunk === "string" ? chunk : Buffer.from(chunk as Uint8Array).toString("utf8"));
  }
  const done = rest.find((r) => typeof r === "function") as (() => void) | undefined;
  if (done) done();
  return true;
}
process.stdout.write = hookedWrite as typeof process.stdout.write;
process.stderr.write = hookedWrite as typeof process.stderr.write;

/** The error with stack frames outside the user's file removed. */
function describe(e: unknown): string {
  if (e instanceof Error) {
    const stack = e.stack ?? `${e.name}: ${e.message}`;
    return stack
      .split("\n")
      .filter((line) => !/^\s+at /.test(line) || line.includes(SOLUTION))
      .join("\n");
  }
  try {
    return "Uncaught " + String(e);
  } catch {
    return "Uncaught exception";
  }
}

/** The message code of a parse error, or null for an error thrown while the module ran. */
function syntaxErrorCode(e: unknown): string | null {
  const code = (e as { code?: unknown } | null)?.code;
  if (code === "ERR_UNSUPPORTED_TYPESCRIPT_SYNTAX") return "unsupported_syntax";
  if (code === "ERR_INVALID_TYPESCRIPT_SYNTAX") return "syntax_error";
  // V8 parse errors carry no stack frames; a SyntaxError thrown at run time
  // (e.g. by JSON.parse) does.
  if (e instanceof SyntaxError && !/\n\s+at /.test(e.stack ?? "")) return "syntax_error";
  return null;
}

async function main(): Promise<void> {
  let mod: Record<string, unknown>;
  try {
    mod = await import("./" + SOLUTION);
  } catch (e) {
    const code = syntaxErrorCode(e);
    if (code !== null) {
      emit({ kind: "compile_error", code, message: describe(e) });
    } else {
      emit({ kind: "load_error", message: describe(e) });
    }
    return;
  }
  const fn = mod[FUNCTION];
  if (typeof fn !== "function") {
    emit({
      kind: "compile_error",
      code: "function_not_found",
      message: `function ${FUNCTION}() is not exported`,
    });
    return;
  }

{% if uses_nodes %}
  const classes = nodeClasses(mod);
{% endif %}
  emit({ kind: "ready" });
  const tests: Rec[] = request.tests;
  for (let i = 0; i < tests.length; i++) {
{% if uses_nodes %}
    const args = PARAMS.map((p, k) => fromJson(PARAM_SHAPES[k][0], PARAM_SHAPES[k][1], tests[i][p], classes));
{% else %}
    const args = PARAMS.map((p) => tests[i][p]);
{% endif %}
    const rec: Rec = { kind: "result", test: i };
    capture = new Capture(cap);
    const start = process.hrtime.bigint();
    try {
      const value = fn(...args);
      rec.status = "ok";
      rec.value = value === undefined ? null : value;
    } catch (e) {
      rec.status = "error";
      rec.error_code = "exception";
      rec.error = describe(e);
    }
    rec.time_us = Number((process.hrtime.bigint() - start) / 1000n);
{% if uses_nodes %}
    if (rec.status === "ok") {
      try {
        rec.value = toJson(RETURN_SHAPE[0], RETURN_SHAPE[1], rec.value);
      } catch (e) {
        delete rec.value;
        rec.status = "error";
        if (e instanceof NodeError) {
          rec.error_code = e.code;
          rec.error = e.message;
        } else {
          rec.error_code = "return_not_serializable";
          rec.error = "return value is not a " + {{ returns_raw | tojson }} + ": " + describe(e);
        }
      }
    }
{% endif %}
    rec.stdout = capture.text;
    rec.stdout_truncated = capture.truncated;
    capture = null;
    let line: string;
    try {
      line = JSON.stringify(rec);
    } catch (e) {
      delete rec.value;
      rec.status = "error";
      rec.error_code = "return_not_serializable";
      rec.error = "return value cannot be converted to JSON: " + describe(e);
      line = JSON.stringify(rec);
    }
    emitLine(line);
  }
  emit({ kind: "done" });
}

await main();
// Do not wait for timers or handles the solution may have left behind.
process.exit(0);
