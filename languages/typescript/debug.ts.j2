// Generated by KataBox: replays {{ function }}() for the debugger (ADR 0022, 0023). Do not edit.
//
// Request on stdin: {"nonce", "max_output_bytes", "trace_budget", "input": {param: value},
// "mode": "trace" | "stop", "max_steps", "max_pauses", "step", "frame",
// "expand": [[scope, name, i...]], "evals": [expr], "visualize": [name] (optional)}. Records go to fd 1 as
// "\n<nonce> <json>\n" (ADR 0008), the same records as the Python debug harness.
//
// Two threads in one file. The main thread imports the solution and calls it. A worker
// thread drives Node's in-process inspector (inspector.Session.connectToMainThread: no
// port, no socket) and steps the main thread through the solution: every other script is
// blackboxed, so harness and Node frames are never seen. A step is a pause in the
// solution whose (line, depth) differs from the previous pause; V8's other pauses on the
// same line are stepped through silently. "trace" records the steps; "stop" replays to
// one step, describes it and ends the process there, so nothing after it runs.
import { Worker, isMainThread, parentPort, workerData } from "node:worker_threads";
import { readFileSync, writeSync } from "node:fs";
import { inspect, types as utilTypes } from "node:util";

const SOLUTION: string = {{ solution_file | tojson }};
const FUNCTION: string = {{ function | tojson }};
const PARAMS: string[] = {{ param_keys | tojson }};
{% if uses_nodes %}
const PARAM_SHAPES: [string, number][] = {{ param_shapes | tojson }};
const RETURN_SHAPE: [string, number] = {{ return_shape | tojson }};

{{ nodes_code }}
{% endif %}

// Trace tokens: each distinct (line, depth) pair gets a code; a step is one character for
// the first 91 codes, or "~" plus two characters after that. Printable ASCII without
// '"', '\' and '~', so JSON never escapes it.
let ALPHABET = "";
for (let c = 33; c < 126; c++) {
  const ch = String.fromCharCode(c);
  if (ch !== '"' && ch !== "\\" && ch !== "~") ALPHABET += ch;
}
const MAX_CODES = ALPHABET.length + ALPHABET.length ** 2;
const REPR_MAX = 200;
const CHILDREN_MAX = 100;
const EVAL_MAX = 2000;
const FNV_OFFSET = 0xcbf29ce484222325n;
const FNV_PRIME = 0x100000001b3n;
const MASK = (1n << 64n) - 1n;

type Rec = Record<string, unknown>;

// --- The visualizer's snapshot (ADR 0027) -------------------------------------------------
// A bounded, structured copy of the requested variables, built in the main thread while it
// is paused at the stop. It never runs user code: Proxies are opaque (checked first, since
// a Proxy of an array passes Array.isArray), only own data properties are read (never a
// getter), Maps and Sets are walked with the saved iterator methods, scalars are formatted
// here, and the result is serialised by hand from null-prototype objects (no toJSON). The
// built-ins it uses are saved now, before the solution loads.
const SNAP_MAX_OBJECTS = 1000;
const SNAP_MAX_ITEMS = 500;
const SNAP_MAX_VALUES = 10_000;
// Estimated JSON bytes: past this the snapshot is cut (truncated), well before the hard cap.
const SNAP_SOFT_BYTES = 200_000;
const SNAP_MAX_DEPTH = 32;
const SNAP_MAX_STR = 64;
const SNAP_MAX_NAMES = 16;
const SNAP_MAX_BYTES = 256 * 1024;
const S = {
  apply: Reflect.apply,
  getDesc: Object.getOwnPropertyDescriptor,
  getProto: Object.getPrototypeOf,
  hasOwn: Object.hasOwn,
  isArray: Array.isArray,
  isInteger: Number.isInteger,
  is: Object.is,
  ownKeys: Reflect.ownKeys,
  isProxy: utilTypes.isProxy,
  isMap: utilTypes.isMap,
  isSet: utilTypes.isSet,
  // Typed arrays (Int32Array, ...) are drawn as lists, marked `typed`. Their length is a
  // getter on the shared prototype; their elements are own data properties.
  isTypedArray: utilTypes.isTypedArray,
  typedLength: Object.getOwnPropertyDescriptor(Object.getPrototypeOf(Int8Array.prototype), "length")!.get!,
  objectProto: Object.prototype,
  mapEntries: Map.prototype.entries,
  mapSize: Object.getOwnPropertyDescriptor(Map.prototype, "size")!.get!,
  mapGet: Map.prototype.get,
  mapSet: Map.prototype.set,
  mapHas: Map.prototype.has,
  setValues: Set.prototype.values,
  setSize: Object.getOwnPropertyDescriptor(Set.prototype, "size")!.get!,
  mapIterNext: Object.getPrototypeOf(new Map().entries()).next,
  setIterNext: Object.getPrototypeOf(new Set().values()).next,
  strSlice: String.prototype.slice,
  stringify: JSON.stringify,
  byteLength: Buffer.byteLength,
  Map,
};
// Input nodes, numbered when the harness builds them (identity across steps).
const INPUT_IDS = new S.Map<object, number>();

function snapOwn(obj: object, key: string): { ok: boolean; value?: unknown } {
  const d = S.getDesc(obj, key);
  if (d === undefined || !S.hasOwn(d, "value")) return { ok: false };
  return { ok: true, value: d.value };
}

function snapTypeName(v: unknown): string {
  if (v === null) return "null";
  if (typeof v !== "object" && typeof v !== "function") return typeof v;
  try {
    if (S.isProxy(v)) return "Proxy";
    const proto = S.getProto(v);
    if (proto === null) return "Object";
    const ctor = snapOwn(proto, "constructor");
    if (ctor.ok && typeof ctor.value === "function") {
      const name = snapOwn(ctor.value as object, "name");
      if (name.ok && typeof name.value === "string" && name.value !== "") return name.value;
    }
  } catch {
    // fall through
  }
  return "Object";
}

/** ["list" | "tree", fields] for a ListNode / TreeNode instance, else null. */
function snapNode(v: unknown): ["list" | "tree", Record<string, unknown>] | null {
  if (v === null || typeof v !== "object" || S.isProxy(v)) return null;
  const name = snapTypeName(v);
  if (name !== "ListNode" && name !== "TreeNode") return null;
  const keys = name === "ListNode" ? ["val", "next"] : ["val", "left", "right"];
  const fields: Record<string, unknown> = { __proto__: null } as unknown as Record<string, unknown>;
  for (let i = 0; i < keys.length; i++) {
    const k = keys[i];
    const f = snapOwn(v, k);
    if (!f.ok) return null;
    fields[k] = f.value;
  }
  return [name === "ListNode" ? "list" : "tree", fields];
}

/** Number the input's nodes in a fixed walk of the arguments. */
function numberInputs(args: unknown[]): void {
  const queue: unknown[] = [];
  for (let i = 0; i < args.length; i++) queue[queue.length] = args[i];
  for (let k = 0; k < queue.length; k++) {
    const v = queue[k];
    if (S.isArray(v) && !S.isProxy(v)) {
      const n = snapOwn(v as object, "length").value as number;
      for (let i = 0; i < n; i++) queue[queue.length] = snapOwn(v as object, `${i}`).value;
      continue;
    }
    const node = snapNode(v);
    if (node === null || S.apply(S.mapHas, INPUT_IDS, [v])) continue;
    S.apply(S.mapSet, INPUT_IDS, [v, S.apply(S.mapSize, INPUT_IDS, [])]);
    const links = node[0] === "list" ? ["next"] : ["left", "right"];
    for (let i = 0; i < links.length; i++) queue[queue.length] = node[1][links[i]];
  }
}

function snapScalar(v: unknown): Rec | null {
  const t = typeof v;
  const mk = (tag: string, text: string): Rec => {
    const o = { __proto__: null } as unknown as Rec;
    o.t = tag;
    o.v = text;
    return o;
  };
  const cut = (text: string): string =>
    text.length <= SNAP_MAX_STR ? text : S.apply(S.strSlice, text, [0, SNAP_MAX_STR - 1]) + "…";
  if (t === "number") {
    const negZero = S.is(v, -0);
    return mk(S.isInteger(v) && !negZero ? "int" : "float", negZero ? "-0" : `${v as number}`);
  }
  if (t === "bigint") {
    const text = `${v as bigint}`;
    return mk("int", text.length <= SNAP_MAX_STR ? text : S.apply(S.strSlice, text, [0, 20]) + `… (${text.length - (text[0] === "-" ? 1 : 0)} digits)`);
  }
  if (t === "string") return mk("str", cut(v as string));
  if (t === "boolean") return mk("bool", v ? "true" : "false");
  if (v === null) return mk("none", "null");
  if (t === "undefined") return mk("none", "undefined");
  return null;
}

/** JSON text of the snapshot's own structure (null-prototype objects and arrays). */
function snapEncode(v: unknown): string {
  if (v === null || typeof v !== "object") {
    return typeof v === "string" ? (S.stringify(v) as string) : typeof v === "number" ? `${v}` : typeof v === "boolean" ? (v ? "true" : "false") : "null";
  }
  if (S.isArray(v)) {
    let out = "[";
    for (let i = 0; i < (v as unknown[]).length; i++) out += (i ? "," : "") + snapEncode((v as unknown[])[i]);
    return out + "]";
  }
  let out = "{";
  let first = true;
  for (const k in v as Rec) {
    const x = (v as Rec)[k];
    if (x === undefined) continue;
    out += (first ? "" : ",") + (S.stringify(k) as string) + ":" + snapEncode(x);
    first = false;
  }
  return out + "}";
}

/** The visualizer's snapshot (ADR 0027) as JSON text. `values` are the frame's locals,
 * then its globals, in the order of `localNames` and `globalNames`. */
function snapshot(names: unknown[], localNames: string[], globalNames: string[], values: unknown[]): string {
  const obj = (): Rec => ({ __proto__: null }) as unknown as Rec;
  const objects: unknown[] = [];
  const roots: unknown[] = [];
  const ids = new S.Map<unknown, number>();
  const queue: [unknown, ["list" | "tree", Record<string, unknown>] | null, number, number][] = [];
  let truncated = false;
  let budget = SNAP_MAX_VALUES;
  let size = 0;
  const full = (): boolean => budget <= 0 || size > SNAP_SOFT_BYTES;

  const opaque = (v: unknown): Rec => {
    const o = obj();
    o.t = "opaque";
    o.v = snapTypeName(v);
    return o;
  };
  const valueOf = (v: unknown, depth: number): Rec => {
    size += 24;
    const scalar = snapScalar(v);
    if (scalar !== null) {
      size += (scalar.v as string).length;
      return scalar;
    }
    if (typeof v !== "object" || v === null || S.isProxy(v)) return opaque(v);
    let node: ReturnType<typeof snapNode> = null;
    const plain = S.getProto(v) === S.objectProto || S.getProto(v) === null;
    if (!S.isArray(v) && !S.isMap(v) && !S.isSet(v) && !S.isTypedArray(v) && !plain) {
      node = snapNode(v);
      if (node === null) return opaque(v);
    }
    const known = S.apply(S.mapGet, ids, [v]) as number | undefined;
    const ref = (id: number): Rec => {
      const o = obj();
      o.t = "ref";
      o.id = id;
      return o;
    };
    if (known !== undefined) return ref(known);
    if (objects.length >= SNAP_MAX_OBJECTS || depth >= SNAP_MAX_DEPTH) {
      truncated = true;
      return opaque(v);
    }
    const index = objects.length;
    size += 48;
    S.apply(S.mapSet, ids, [v, index]);
    objects[index] = null;
    queue[queue.length] = [v, node, index, depth];
    return ref(index);
  };

  const fill = (v: unknown, node: ReturnType<typeof snapNode>, index: number, depth: number): void => {
    const o = obj();
    if (node !== null) {
      budget--;
      o.kind = node[0] === "list" ? "list_node" : "tree_node";
      o.val = valueOf(node[1].val, depth + 1);
      const links = node[0] === "list" ? ["next"] : ["left", "right"];
      for (let i = 0; i < links.length; i++) o[links[i]] = valueOf(node[1][links[i]], depth + 1);
      const n = S.apply(S.mapGet, INPUT_IDS, [v]);
      if (n !== undefined) o.input = n;
    } else if (S.isMap(v) || (!S.isArray(v) && !S.isSet(v) && !S.isTypedArray(v))) {
      const entries: unknown[] = [];
      const add = (k: unknown, x: unknown): boolean => {
        if (entries.length >= SNAP_MAX_ITEMS || budget <= 1 || full()) {
          truncated = true;
          return false;
        }
        budget -= 2;
        entries[entries.length] = [valueOf(k, depth + 1), valueOf(x, depth + 1)];
        return true;
      };
      let len = 0;
      if (S.isMap(v)) {
        o.type = snapTypeName(v);
        len = S.apply(S.mapSize, v, []) as number;
        const it = S.apply(S.mapEntries, v, []);
        for (;;) {
          const step = S.apply(S.mapIterNext, it, []) as { done: boolean; value: [unknown, unknown] };
          if (step.done || !add(step.value[0], step.value[1])) break;
        }
      } else {
        o.type = "Object";
        const own = S.ownKeys(v as object) as (string | symbol)[];
        const keys: string[] = [];
        for (let i = 0; i < own.length; i++) if (typeof own[i] === "string") keys[keys.length] = own[i] as string;
        len = keys.length;
        for (let i = 0; i < keys.length; i++) {
          const f = snapOwn(v as object, keys[i]);
          if (!add(keys[i], f.ok ? f.value : undefined)) break;
        }
      }
      o.kind = "map";
      o.entries = entries;
      o.len = len;
    } else {
      const items: unknown[] = [];
      const pushRec = (rec: () => Rec): boolean => {
        if (items.length >= SNAP_MAX_ITEMS || full()) {
          truncated = true;
          return false;
        }
        budget--;
        items[items.length] = rec();
        return true;
      };
      const push = (x: unknown): boolean => pushRec(() => valueOf(x, depth + 1));
      let len = 0;
      if (S.isSet(v)) {
        o.kind = "set";
        len = S.apply(S.setSize, v, []) as number;
        const it = S.apply(S.setValues, v, []);
        for (;;) {
          const step = S.apply(S.setIterNext, it, []) as { done: boolean; value: unknown };
          if (step.done || !push(step.value)) break;
        }
      } else {
        o.kind = "list";
        if (S.isTypedArray(v)) {
          o.typed = true;
          len = S.apply(S.typedLength, v, []) as number;
        } else {
          len = snapOwn(v as object, "length").value as number;
        }
        for (let i = 0; i < len; i++) {
          // An index may be an accessor: never call its getter.
          const d = S.getDesc(v as object, `${i}`);
          const ok =
            d === undefined
              ? push(undefined)
              : S.hasOwn(d, "value")
                ? push(d.value)
                : pushRec(() => {
                    const o2 = obj();
                    o2.t = "opaque";
                    o2.v = "accessor";
                    return o2;
                  });
          if (!ok) break;
        }
      }
      o.type = snapTypeName(v);
      o.items = items;
      o.len = len;
    }
    objects[index] = o;
  };

  const has = (list: string[], x: string): boolean => {
    for (let i = 0; i < list.length; i++) if (list[i] === x) return true;
    return false;
  };
  const failed = (error: string): string => `{"roots":[],"objects":[],"truncated":true,"error":${S.stringify(error)}}`;
  try {
    const chosen: string[] = [];
    const lookup = (name: string): { ok: boolean; value?: unknown } => {
      for (let i = 0; i < localNames.length; i++) if (localNames[i] === name) return { ok: true, value: values[i] };
      for (let i = 0; i < globalNames.length; i++) if (globalNames[i] === name) return { ok: true, value: values[localNames.length + i] };
      return { ok: false };
    };
    for (let i = 0; i < names.length && i < SNAP_MAX_NAMES; i++) {
      const name = names[i];
      if (typeof name !== "string" || has(chosen, name)) continue;
      const found = lookup(name);
      if (!found.ok) continue;
      chosen[chosen.length] = name;
      const r = obj();
      r.name = name;
      r.value = valueOf(found.value, 0);
      roots[roots.length] = r;
    }
    // Every other local holding a node, so pointers like slow / fast are labelled.
    for (let i = 0; i < localNames.length; i++) {
      const name = localNames[i];
      if (has(chosen, name) || snapNode(values[i]) === null) continue;
      chosen[chosen.length] = name;
      const r = obj();
      r.name = name;
      r.value = valueOf(values[i], 0);
      roots[roots.length] = r;
    }
    for (let k = 0; k < queue.length; k++) fill(queue[k][0], queue[k][1], queue[k][2], queue[k][3]);
    const snap = obj();
    snap.roots = roots;
    snap.objects = objects;
    snap.truncated = truncated;
    const text = snapEncode(snap);
    return (S.byteLength(text, "utf8") as number) > SNAP_MAX_BYTES ? failed("too_large") : text;
  } catch (e) {
    return failed("snapshot failed: " + snapTypeName(e));
  }
}

type VarInfo = { name: string; type: string; value: string; children: number };

function emitTo(nonce: string, text: string): void {
  writeSync(1, "\n" + nonce + " " + text + "\n");
}

/** The error with stack frames outside the user's file removed. */
function describeError(e: unknown): string {
  if (e instanceof Error) {
    const stack = e.stack ?? `${e.name}: ${e.message}`;
    return stack
      .split("\n")
      .filter((line) => !/^\s+at /.test(line) || line.includes(SOLUTION))
      .join("\n");
  }
  try {
    return "Uncaught " + String(e);
  } catch {
    return "Uncaught exception";
  }
}

// --- Main thread: the program -----------------------------------------------------------

function short(text: string): string {
  return text.length > REPR_MAX ? text.slice(0, REPR_MAX - 1) + "…" : text;
}

function typeName(v: unknown): string {
  if (v === null) return "null";
  if (typeof v !== "object" && typeof v !== "function") return typeof v;
  const name = (v as { constructor?: { name?: unknown } }).constructor?.name;
  return typeof name === "string" && name !== "" ? name : "Object";
}

const NODE_PREVIEW = 10;

/** "list" or "tree" for a ListNode / TreeNode instance (ADR 0025), else null. */
function nodeKind(v: unknown): "list" | "tree" | null {
  if (v === null || typeof v !== "object") return null;
  const name = typeName(v);
  if (name === "ListNode" && "val" in v && "next" in v) return "list";
  if (name === "TreeNode" && "val" in v && "left" in v && "right" in v) return "tree";
  return null;
}

/** A short, cycle-safe line for a node: never the whole chain. */
function nodeText(v: Record<string, unknown>, kind: "list" | "tree"): string {
  const val = (n: unknown): string => {
    if (n === null || n === undefined) return "null";
    const x = (n as Record<string, unknown>).val;
    const t = typeof x === "number" || typeof x === "string" || typeof x === "boolean" ? String(x) : "…";
    return t.length <= 20 ? t : t.slice(0, 19) + "…";
  };
  if (kind === "tree") return `TreeNode(${val(v)}, left=${val(v.left)}, right=${val(v.right)})`;
  const parts: string[] = [];
  const seen = new Set<unknown>();
  let node: unknown = v;
  while (node !== null && node !== undefined && parts.length < NODE_PREVIEW) {
    if (seen.has(node)) {
      parts.push("↺");
      node = null;
      break;
    }
    seen.add(node);
    parts.push(val(node));
    node = (node as Record<string, unknown>).next;
  }
  if (node !== null && node !== undefined) parts.push("…");
  return "ListNode [" + parts.join(" → ") + "]";
}

/** (name, child) pairs of a container or plain object, in a stable order. */
function childrenOf(v: unknown): [string, unknown][] {
  if (v === null || typeof v !== "object") return [];
  const kind = nodeKind(v);
  const node = v as Record<string, unknown>;
  if (kind === "list") return [["val", node.val], ["next", node.next]];
  if (kind === "tree") return [["val", node.val], ["left", node.left], ["right", node.right]];
  if (Array.isArray(v)) return v.map((x, i) => ["[" + i + "]", x]);
  if (ArrayBuffer.isView(v) && !(v instanceof DataView)) {
    return Array.from(v as unknown as ArrayLike<unknown>, (x, i) => ["[" + i + "]", x]);
  }
  if (v instanceof Map) return [...v.entries()].map(([k, x]) => [short(inspect(k)), x]);
  if (v instanceof Set) return [...v.values()].map((x) => ["", x]);
  return Object.keys(v).map((k) => [k, (v as Record<string, unknown>)[k]]);
}

function countChildren(v: unknown): number {
  try {
    if (Array.isArray(v)) return v.length;
    if (v instanceof Map || v instanceof Set) return v.size;
    return childrenOf(v).length;
  } catch {
    return 0;
  }
}

function describeValue(name: string, v: unknown): VarInfo {
  let text: string;
  const kind = nodeKind(v);
  try {
    text = kind !== null ? nodeText(v as Record<string, unknown>, kind) : inspect(v, { depth: 2, breakLength: Infinity, maxArrayLength: 50, maxStringLength: REPR_MAX });
  } catch (e) {
    text = "<inspect failed: " + typeName(e) + ">";
  }
  return { name, type: typeName(v), value: short(text), children: countChildren(v) };
}

async function mainThread(): Promise<void> {
  const request = JSON.parse(readFileSync(0, "utf8"));
  const nonce: string = request.nonce;
  const emit = (rec: Rec) => emitTo(nonce, JSON.stringify(rec));

  // Replays must take the same path: a seeded Math.random (mulberry32, seed 0). Clocks
  // are left alone; a program that depends on them is caught by the divergence check.
  let seed = 0;
  Math.random = () => {
    seed = (seed + 0x6d2b79f5) | 0;
    let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };

  // shared[0] = the step the user's code is at (prints are tagged with it).
  const shared = new Int32Array(new SharedArrayBuffer(8));
  const cap: number = request.mode === "stop" ? 0 : request.max_output_bytes;
  const prints: [number, string][] = [];
  let printed = 0;
  let printsTruncated = false;
  let evalOut: string | null = null;
  const hookedWrite = (chunk: unknown, ...rest: unknown[]): boolean => {
    let s = typeof chunk === "string" ? chunk : Buffer.from(chunk as Uint8Array).toString("utf8");
    if (evalOut !== null) {
      evalOut += s;
    } else {
      const room = cap - printed;
      if (s.length > room) {
        printsTruncated = true;
        s = s.slice(0, Math.max(room, 0));
      }
      if (s) {
        const step = Atomics.load(shared, 0);
        const last = prints[prints.length - 1];
        if (last && last[0] === step) last[1] += s;
        else prints.push([step, s]);
        printed += s.length;
      }
    }
    const done = rest.find((r) => typeof r === "function") as (() => void) | undefined;
    if (done) done();
    return true;
  };

  // Helpers the recorder calls inside this thread while it is paused.
  const g = globalThis as unknown as Record<string, unknown>;
  g.__katabox_describe = (v: unknown) => describeValue("", v);
  g.__katabox_expand = (v: unknown, rest: number[]) => {
    let value = v;
    for (const i of rest) value = childrenOf(value)[i][1];
    const kids = childrenOf(value);
    return {
      children: kids.slice(0, CHILDREN_MAX).map(([n, x]) => describeValue(n, x)),
      more: Math.max(kids.length - CHILDREN_MAX, 0),
    };
  };
  g.__katabox_snapshot = (names: unknown[], localNames: string[], globalNames: string[], values: unknown[]) =>
    snapshot(names, localNames, globalNames, values);
  g.__katabox_mark = () => {
    evalOut = "";
  };
  g.__katabox_take = () => {
    const out = (evalOut ?? "").slice(0, EVAL_MAX);
    evalOut = null;
    return out;
  };
  g.__katabox_prints = () => JSON.stringify({ prints, prints_truncated: printsTruncated });

  let mod: Record<string, unknown>;
  process.stdout.write = hookedWrite as typeof process.stdout.write;
  process.stderr.write = hookedWrite as typeof process.stderr.write;
  evalOut = ""; // output while the module loads is discarded
  try {
    mod = await import("./" + SOLUTION);
  } catch (e) {
    emit({ kind: "load_error", message: describeError(e) });
    process.exit(0);
  }
  evalOut = null;
  const fn = mod[FUNCTION];
  if (typeof fn !== "function") {
    emit({ kind: "load_error", message: `function ${FUNCTION}() is not exported` });
    process.exit(0);
  }

  // The recorder: it must be connected before the call. Wait for it asynchronously, so
  // this thread can answer the inspector (Atomics.wait here would deadlock).
  const keepAlive = setInterval(() => {}, 1 << 30);
  const recorder = new Worker(new URL(import.meta.url), { workerData: { request, shared } });
  recorder.on("error", (e) => {
    emit({ kind: "load_error", message: "the debugger could not start: " + describeError(e) });
    process.exit(0);
  });
  await new Promise((ok) => recorder.once("message", ok));

{% if uses_nodes %}
  const classes = nodeClasses(mod);
  const args = PARAMS.map((p, k) => fromJson(PARAM_SHAPES[k][0], PARAM_SHAPES[k][1], request.input[p], classes));
  if (Array.isArray(request.visualize)) numberInputs(args);
{% else %}
  const args = PARAMS.map((p) => request.input[p]);
{% endif %}
  const outcome: Rec = { kind: "outcome" };
  // The recorder starts stepping at this statement (this file is not blackboxed yet).
  debugger;
  try {
    const value = (fn as (...a: unknown[]) => unknown)(...args);
    outcome.status = "ok";
    outcome.value = value === undefined ? null : value;
  } catch (e) {
    outcome.status = "error";
    outcome.error = describeError(e);
    const at = e instanceof Error ? (e.stack ?? "").match(new RegExp(SOLUTION.replace(/\./g, "\\.") + ":(\\d+):\\d+")) : null;
    outcome.line = at ? Number(at[1]) : null;
  }
{% if uses_nodes %}
  if (outcome.status === "ok") {
    try {
      outcome.value = toJson(RETURN_SHAPE[0], RETURN_SHAPE[1], outcome.value);
    } catch (e) {
      delete outcome.value;
      outcome.status = "error";
      outcome.error = e instanceof NodeError ? e.message : "return value is not a " + {{ returns_raw | tojson }} + ": " + describeError(e);
    }
  }
{% endif %}
  let outcomeText: string;
  try {
    outcomeText = JSON.stringify(outcome);
  } catch (e) {
    delete outcome.value;
    outcome.status = "error";
    outcome.error = "return value cannot be converted to JSON: " + describeError(e);
    outcomeText = JSON.stringify(outcome);
  }
  // The recorder writes the trace (or "diverged" in stop mode) and then the outcome.
  const written = new Promise((ok) => recorder.once("message", ok));
  recorder.postMessage({ prints, prints_truncated: printsTruncated, outcome: outcomeText });
  await written;
  clearInterval(keepAlive);
  process.exit(0);
}

// --- Worker thread: the recorder --------------------------------------------------------

async function recorderThread(): Promise<void> {
  const { Session } = await import("node:inspector");
  const { request, shared } = workerData as { request: Rec; shared: Int32Array };
  const nonce = request.nonce as string;
  const mode = request.mode as string;
  const maxSteps = (request.max_steps as number) ?? 15_000;
  const maxPauses = (request.max_pauses as number) ?? 20_000;
  const budget = (request.trace_budget as number) ?? 1 << 20;
  const target = (request.step as number) ?? 0;
  setInterval(() => {}, 1 << 30); // keep this thread's loop alive

  const session = new Session();
  session.connectToMainThread();
  const post = (method: string, params?: object): Promise<any> =>
    new Promise((ok, no) => session.post(method, params ?? {}, (e: Error | null, r: unknown) => (e ? no(e) : ok(r))));

  let solutionId: string | null = null;
  session.on("Debugger.scriptParsed", ({ params }: any) => {
    if (typeof params.url === "string" && params.url.endsWith("/" + SOLUTION)) solutionId = params.scriptId;
  });

  let boxed = false;
  let steps = 0;
  let pauses = 0;
  let prev: { line: number; depth: number } | null = null;
  let hash = FNV_OFFSET;
  const codes = new Map<string, number>();
  const table: [number, number][] = [];
  let tokens = "";
  let truncated: string | null = null;

  const traceText = (prints: unknown, printsTruncated: boolean): string =>
    JSON.stringify({
      kind: "trace",
      table,
      tokens,
      steps,
      truncated,
      prints,
      prints_truncated: printsTruncated,
    });

  /** End the whole process from inside the paused main thread: nothing after runs. */
  const endHere = async (frameId: string): Promise<void> => {
    await post("Debugger.evaluateOnCallFrame", { callFrameId: frameId, expression: "globalThis.process.exit(0)" });
  };

  const onFrame = (frameId: string, expression: string, returnByValue = true) =>
    post("Debugger.evaluateOnCallFrame", { callFrameId: frameId, expression, returnByValue, silent: true });

  /** A RemoteObject as a VarInfo (objects are described inside the main thread). */
  const describeRemote = async (name: string, obj: any): Promise<VarInfo> => {
    if (obj.objectId) {
      const r = await post("Runtime.callFunctionOn", {
        objectId: obj.objectId,
        functionDeclaration: "function () { return globalThis.__katabox_describe(this); }",
        returnByValue: true,
        silent: true,
      });
      const v = r.result?.value as VarInfo | undefined;
      if (v) return { ...v, name };
    }
    let value: string;
    if ("unserializableValue" in obj) value = String(obj.unserializableValue);
    else if (obj.type === "undefined") value = "undefined";
    else if ("value" in obj) value = inspect(obj.value, { maxStringLength: REPR_MAX });
    else value = String(obj.description ?? "");
    const type = obj.subtype === "null" ? "null" : String(obj.type);
    return { name, type, value: value.length > REPR_MAX ? value.slice(0, REPR_MAX - 1) + "…" : value, children: 0 };
  };

  /** The variables of one scope object: [name, RemoteObject] pairs. */
  const scopeVars = async (scope: any): Promise<[string, any][]> => {
    const r = await post("Runtime.getProperties", { objectId: scope.object.objectId, ownProperties: true });
    return (r.result as any[])
      .filter((p) => p.value !== undefined)
      .map((p) => [p.name, p.value] as [string, any]);
  };

  /** A RemoteObject as an argument of Runtime.callFunctionOn. */
  const asArgument = (obj: any): Rec => {
    if (obj.objectId) return { objectId: obj.objectId };
    if ("unserializableValue" in obj) return { unserializableValue: obj.unserializableValue };
    if (obj.type === "undefined") return {};
    return { value: obj.value };
  };

  /** The visualizer's snapshot (ADR 0027), built in the main thread in one call. */
  const snapshotOf = async (chosen: any, locals: [string, any][], globals: [string, any][]): Promise<unknown> => {
    const failed = (error: string) => ({ roots: [], objects: [], truncated: true, error });
    try {
      // First occurrence wins: the scope chain lists inner scopes first.
      const seen = new Set<string>();
      const pick = (vars: [string, any][]) => vars.filter(([n]) => (seen.has(n) ? false : (seen.add(n), true)));
      const ls = pick(locals);
      const gs = pick(globals);
      const target = chosen.scopeChain.find((sc: any) => sc.object?.objectId)?.object.objectId;
      if (!target) return failed("snapshot failed: no scope");
      const r = await post("Runtime.callFunctionOn", {
        objectId: target,
        functionDeclaration:
          "function (names, localNames, globalNames, ...values) { return globalThis.__katabox_snapshot(names, localNames, globalNames, values); }",
        arguments: [
          { value: (request.visualize as unknown[]).slice(0, SNAP_MAX_NAMES) },
          { value: ls.map(([n]) => n) },
          { value: gs.map(([n]) => n) },
          ...ls.map(([, v]) => asArgument(v)),
          ...gs.map(([, v]) => asArgument(v)),
        ],
        returnByValue: true,
        silent: true,
      });
      if (r.exceptionDetails || typeof r.result?.value !== "string") return failed("snapshot failed");
      return JSON.parse(r.result.value);
    } catch (e) {
      return failed("snapshot failed: " + String(e).slice(0, 200));
    }
  };

  const describeStop = async (callFrames: any[]): Promise<Rec> => {
    const frames = callFrames.filter((f) => f.location.scriptId === solutionId);
    const index = Math.min(Math.max((request.frame as number) ?? 0, 0), frames.length - 1);
    const chosen = frames[index];
    const locals: [string, any][] = [];
    const globals: [string, any][] = [];
    for (const scope of chosen.scopeChain) {
      if (["local", "block", "catch", "closure"].includes(scope.type)) locals.push(...(await scopeVars(scope)));
      else if (scope.type === "module") {
        for (const [n, v] of await scopeVars(scope)) {
          if (v.type !== "function" && n !== FUNCTION) globals.push([n, v]);
        }
      }
    }
    const record: Rec = {
      kind: "stop",
      step: target,
      stack: frames.map((f) => ({ function: f.functionName || "(anonymous)", line: f.location.lineNumber + 1 })),
      frame: index,
      locals: await Promise.all(locals.map(([n, v]) => describeRemote(n, v))),
      globals: await Promise.all(globals.map(([n, v]) => describeRemote(n, v))),
      expanded: [] as unknown[],
      evals: [] as unknown[],
    };
    const scopes: Record<string, [string, any][]> = { locals, globals };
    for (const path of (request.expand as unknown[][]) ?? []) {
      let entry: Rec = { path, children: [], more: 0 };
      try {
        const root = (scopes[path[0] as string] ?? []).find(([n]) => n === path[1])?.[1];
        if (root?.objectId) {
          const r = await post("Runtime.callFunctionOn", {
            objectId: root.objectId,
            functionDeclaration: "function (rest) { return globalThis.__katabox_expand(this, rest); }",
            arguments: [{ value: path.slice(2) }],
            returnByValue: true,
            silent: true,
          });
          if (r.result?.value && !r.exceptionDetails) entry = { path, ...r.result.value };
        }
      } catch {
        // An expansion that no longer fits the data shows as empty.
      }
      (record.expanded as unknown[]).push(entry);
    }
    for (const expr of (request.evals as string[]) ?? []) {
      await onFrame(chosen.callFrameId, "globalThis.__katabox_mark()");
      const r = await post("Debugger.evaluateOnCallFrame", {
        callFrameId: chosen.callFrameId,
        expression: expr,
        silent: true,
      });
      const out = (await onFrame(chosen.callFrameId, "globalThis.__katabox_take()")).result?.value ?? "";
      if (r.exceptionDetails) {
        const d = r.exceptionDetails.exception?.description ?? r.exceptionDetails.text ?? "error";
        (record.evals as unknown[]).push({ expr, ok: false, error: String(d).split("\n")[0], stdout: out });
      } else {
        (record.evals as unknown[]).push({ expr, ok: true, value: await describeRemote("", r.result), stdout: out });
      }
    }
    if (Array.isArray(request.visualize)) {
      // After the evaluations: the snapshot shows the state the Variables view shows.
      record.snapshot = await snapshotOf(chosen, locals, globals);
    }
    return record;
  };

  /** The stop record as JSON text: the hash is a u64, beyond JSON's safe integers. */
  const stopText = (record: Rec): string => {
    const text = JSON.stringify(record);
    return text.slice(0, -1) + ',"hash":' + hash.toString() + "}";
  };

  const finishTrace = async (frameId: string): Promise<void> => {
    const got = await onFrame(frameId, "globalThis.__katabox_prints()");
    const { prints, prints_truncated } = JSON.parse(got.result.value);
    emitTo(nonce, traceText(prints, prints_truncated));
    await endHere(frameId);
  };

  session.on("Debugger.paused", async ({ params }: any) => {
    try {
      const callFrames: any[] = params.callFrames;
      const user = callFrames.filter((f) => f.location.scriptId === solutionId);
      if (user.length === 0) {
        // The harness's `debugger;`: from now on only the solution is stepped through.
        if (!boxed) {
          boxed = true;
          const escaped = SOLUTION.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
          await post("Debugger.setBlackboxPatterns", { patterns: ["^(?!.*/" + escaped + "$)"] });
        }
        await post("Debugger.stepInto");
        return;
      }
      pauses++;
      const line = user[0].location.lineNumber + 1;
      const depth = user.length;
      if (prev && prev.line === line && prev.depth === depth) {
        if (mode === "trace" && pauses > maxPauses) {
          truncated = "steps";
          await finishTrace(callFrames[0].callFrameId);
          return;
        }
        await post("Debugger.stepInto");
        return;
      }
      prev = { line, depth };
      if (mode === "stop") {
        hash = ((hash ^ BigInt(line)) * FNV_PRIME) & MASK;
        hash = ((hash ^ BigInt(depth)) * FNV_PRIME) & MASK;
        if (steps === target) {
          emitTo(nonce, stopText(await describeStop(callFrames)));
          await endHere(callFrames[0].callFrameId);
          return;
        }
        steps++;
        Atomics.store(shared, 0, steps - 1);
        await post("Debugger.stepInto");
        return;
      }
      const key = line + ":" + depth;
      let code = codes.get(key);
      if (code === undefined) {
        code = table.length;
        if (code >= MAX_CODES) truncated = "codes";
        else {
          codes.set(key, code);
          table.push([line, depth]);
        }
      }
      let token = "";
      if (truncated === null) {
        token =
          code < ALPHABET.length
            ? ALPHABET[code]
            : "~" + ALPHABET[Math.floor((code - ALPHABET.length) / ALPHABET.length)] + ALPHABET[(code - ALPHABET.length) % ALPHABET.length];
        if (steps >= maxSteps || pauses > maxPauses) truncated = "steps";
        else if (tokens.length + token.length > budget) truncated = "bytes";
      }
      if (truncated !== null) {
        await finishTrace(callFrames[0].callFrameId);
        return;
      }
      tokens += token;
      steps++;
      Atomics.store(shared, 0, steps - 1);
      await post("Debugger.stepInto");
    } catch (e) {
      emitTo(nonce, JSON.stringify({ kind: "load_error", message: "the debugger failed: " + String(e) }));
      process.exit(0);
    }
  });

  // The program finished (the main thread is no longer paused).
  parentPort!.on("message", (done: { prints: unknown; prints_truncated: boolean; outcome: string }) => {
    if (mode === "stop") {
      // It ended before the requested step: this run went another way.
      emitTo(nonce, JSON.stringify({ kind: "diverged", steps }));
    } else {
      emitTo(nonce, traceText(done.prints, done.prints_truncated));
      emitTo(nonce, done.outcome.slice(0, -1) + ',"step":' + Math.max(steps - 1, 0) + "}");
    }
    parentPort!.postMessage("written");
  });

  await post("Debugger.enable");
  parentPort!.postMessage("ready");
}

if (isMainThread) await mainThread();
else await recorderThread();
