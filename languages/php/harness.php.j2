<?php
// Generated by KataBox: runs the tests for {{ function }}(). Do not edit.
//
// Protocol (ADR 0008): stdin is {"nonce", "max_output_bytes", "tests": [{param: value}]}.
// Every record goes to STDOUT as "\n<nonce> <json>\n" (fwrite bypasses output
// buffering); anything else on stdout is ignored. The user's output is captured per
// test with an output buffer, never mixed with records.

const KB_SOLUTION = {{ solution_file | tojson }};
const KB_FUNCTION = {{ function | tojson }};
const KB_PARAMS = {{ param_keys | tojson }};
// Array levels of the return type: lists are re-indexed so that, for example, the
// result of array_filter() still encodes as a JSON array.
const KB_RETURN_DEPTH = {{ return_depth }};
const KB_JSON = JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE | JSON_PRESERVE_ZERO_FRACTION
    | JSON_THROW_ON_ERROR;

/** Collects one test's output, up to a cap. */
final class KbCapture
{
    public string $text = '';
    public bool $truncated = false;

    public function __construct(private int $cap)
    {
    }

    public function add(string $chunk, int $phase): string
    {
        $room = $this->cap - strlen($this->text);
        if (strlen($chunk) > $room) {
            $this->truncated = true;
            $chunk = substr($chunk, 0, max($room, 0));
        }
        $this->text .= $chunk;
        return '';
    }
}

final class KbState
{
    public static string $nonce = '';
    public static bool $ready = false;
    public static bool $finished = false;
}

function kb_emit(array $record): void
{
    $flags = JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE | JSON_PRESERVE_ZERO_FRACTION
        | JSON_INVALID_UTF8_SUBSTITUTE | JSON_PARTIAL_OUTPUT_ON_ERROR;
    fwrite(STDOUT, "\n" . KbState::$nonce . " " . json_encode($record, $flags) . "\n");
}

/** The exception with its location and the frames inside the user's file. */
function kb_describe(Throwable $e): string
{
    $text = get_class($e) . ": " . $e->getMessage()
        . " in " . basename($e->getFile()) . ":" . $e->getLine();
    foreach ($e->getTrace() as $frame) {
        if (isset($frame['file']) && basename($frame['file']) === KB_SOLUTION) {
            $text .= "\n  at " . ($frame['function'] ?? '?') . "() (" . KB_SOLUTION . ":" . $frame['line'] . ")";
        }
    }
    return $text;
}

function kb_lists(mixed $value, int $depth): mixed
{
    if ($depth <= 0 || !is_array($value)) {
        return $value;
    }
    return array_map(fn ($v) => kb_lists($v, $depth - 1), array_values($value));
}

// Warnings and notices become part of the current test's output.
set_error_handler(function (int $no, string $message, string $file, int $line): bool {
    if (!(error_reporting() & $no)) {
        return false;
    }
    echo "Warning: $message in " . basename($file) . " on line $line\n";
    return true;
});

// Fatal errors cannot be caught. Before the tests start they mean the solution did not
// compile (e.g. "Cannot redeclare"); later, the judge reads stderr and the exit code.
register_shutdown_function(function (): void {
    if (KbState::$ready || KbState::$finished) {
        return;
    }
    KbState::$finished = true;
    $error = error_get_last();
    if ($error !== null && ($error['type'] & (E_ERROR | E_PARSE | E_CORE_ERROR | E_COMPILE_ERROR))) {
        kb_emit([
            'kind' => 'compile_error',
            'code' => 'compile_error',
            'message' => "PHP Fatal error: " . $error['message'] . " in " . basename($error['file'])
                . " on line " . $error['line'],
        ]);
    } else {
        kb_emit(['kind' => 'load_error', 'message' => 'the solution stopped the program while loading']);
    }
});

$kb_request = json_decode(stream_get_contents(STDIN), true, 512, JSON_THROW_ON_ERROR);
KbState::$nonce = $kb_request['nonce'];
$kb_cap = (int) $kb_request['max_output_bytes'];

// Output while the solution loads is discarded.
ob_start(fn (string $chunk, int $phase): string => '');
try {
    include KB_SOLUTION;
} catch (ParseError $e) {
    ob_end_clean();
    KbState::$finished = true;
    kb_emit([
        'kind' => 'compile_error',
        'code' => 'syntax_error',
        'message' => "PHP Parse error: " . $e->getMessage() . " in " . KB_SOLUTION . " on line " . $e->getLine(),
    ]);
    exit(0);
} catch (Throwable $e) {
    ob_end_clean();
    KbState::$finished = true;
    kb_emit(['kind' => 'load_error', 'message' => kb_describe($e)]);
    exit(0);
}
ob_end_clean();

if (!function_exists(KB_FUNCTION)) {
    KbState::$finished = true;
    kb_emit([
        'kind' => 'compile_error',
        'code' => 'function_not_found',
        'message' => "function " . KB_FUNCTION . "() is not defined",
    ]);
    exit(0);
}

KbState::$ready = true;
kb_emit(['kind' => 'ready']);
foreach ($kb_request['tests'] as $kb_i => $kb_test) {
    $kb_args = array_map(fn (string $p) => $kb_test[$p], KB_PARAMS);
    $kb_capture = new KbCapture($kb_cap);
    $kb_record = ['kind' => 'result', 'test' => $kb_i];
    ob_start([$kb_capture, 'add'], 4096);
    $kb_level = ob_get_level();
    $kb_start = hrtime(true);
    try {
        $kb_value = kb_lists((KB_FUNCTION)(...$kb_args), KB_RETURN_DEPTH);
        $kb_record['status'] = 'ok';
    } catch (Throwable $e) {
        $kb_record['status'] = 'error';
        $kb_record['error_code'] = 'exception';
        $kb_record['error'] = kb_describe($e);
    }
    $kb_record['time_us'] = intdiv(hrtime(true) - $kb_start, 1000);
    // Close any buffers the solution left open, then ours (unless it closed ours).
    while (ob_get_level() > $kb_level) {
        ob_end_flush();
    }
    if (ob_get_level() === $kb_level) {
        ob_end_flush();
    }
    $kb_record['stdout'] = $kb_capture->text;
    $kb_record['stdout_truncated'] = $kb_capture->truncated;
    if ($kb_record['status'] === 'ok') {
        try {
            json_encode($kb_value, KB_JSON);
            $kb_record['value'] = $kb_value;
        } catch (JsonException $e) {
            $kb_record['status'] = 'error';
            $kb_record['error_code'] = 'return_not_serializable';
            $kb_record['error'] = "return value cannot be converted to JSON: " . $e->getMessage();
        }
    }
    kb_emit($kb_record);
    unset($kb_value);
}
KbState::$finished = true;
kb_emit(['kind' => 'done']);
exit(0);
