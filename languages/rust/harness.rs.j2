    // ---- Main loop ------------------------------------------------------------------

    static PANIC: Mutex<Option<String>> = Mutex::new(None);

    fn record(nonce: &str, body: &str) -> String {
        // Built by hand: doubled braces would read as template syntax.
        let mut line = String::with_capacity(body.len() + nonce.len() + 5);
        line.push('\n');
        line.push_str(nonce);
        line.push_str(" {");
        line.push_str(body);
        line.push_str("}\n");
        line
    }

    pub fn main() {
        let mut input = String::new();
        if std::io::stdin().read_to_string(&mut input).is_err() {
            std::process::exit(70);
        }
        panic::set_hook(Box::new(|info| {
            let payload = info.payload();
            let msg = payload
                .downcast_ref::<&str>()
                .map(|s| s.to_string())
                .or_else(|| payload.downcast_ref::<String>().cloned())
                .unwrap_or_else(|| "Box<dyn Any>".into());
            let at = info
                .location()
                .map(|l| format!(" at {}:{}:{}", l.file(), l.line(), l.column()))
                .unwrap_or_default();
            if let Ok(mut slot) = PANIC.lock() {
                *slot = Some(format!("panicked{at}:\n{msg}"));
            }
        }));

        // Run on a thread with a large stack: deep recursion is common in solutions.
        let worker = std::thread::Builder::new()
            .stack_size(64 << 20)
            .spawn(move || {
                // Read on this thread: arguments such as `Rc` trees cannot cross threads.
                // The tests are read straight into arguments (ADR 0026); the rest stays
                // `Json`. A broken request ends the process before any record, as before.
                let (request, tests) = match read_request(&input) {
                    Ok(r) => r,
                    Err(_) => std::process::exit(70),
                };
                let nonce = match request.get("nonce") {
                    Some(Json::Str(s)) => s.clone(),
                    _ => std::process::exit(70),
                };
                let cap = match request.get("max_output_bytes") {
                    Some(Json::Int(n)) => usize::try_from(*n).unwrap_or(65536),
                    Some(Json::Num(n)) => n.parse::<usize>().unwrap_or(65536),
                    _ => 65536,
                };
                run_all(&nonce, cap, tests);
            });
        let code = match worker.map(|w| w.join()) {
            Ok(Ok(())) => 0,
            _ => 70,
        };
        // Do not wait for threads the solution may have left running.
        std::process::exit(code);
    }

    fn run_all(nonce: &str, cap: usize, tests: Vec<Result<Args, String>>) {
        let mut out = std::mem::ManuallyDrop::new(capture::real_stdout());
        let mut emit = |body: String| {
            let _ = out.write_all(record(nonce, &body).as_bytes());
            let _ = out.flush();
        };
        emit("\"kind\":\"ready\"".into());
        for (i, test) in tests.into_iter().enumerate() {
            let mut body = format!("\"kind\":\"result\",\"test\":{i}");
            let args = match test {
                Ok(a) => a,
                Err(e) => {
                    let mut err = String::new();
                    write_str(&mut err, &format!("harness: bad input: {e}"));
                    body.push_str(&format!(
                        ",\"status\":\"error\",\"error_code\":\"exception\",\"error\":{err},\"time_us\":0,\"stdout\":\"\",\"stdout_truncated\":false"
                    ));
                    emit(body);
                    continue;
                }
            };
            if let Ok(mut slot) = PANIC.lock() {
                *slot = None;
            }
            let cap_handle = capture::begin(cap);
            let start = Instant::now();
            let result = panic::catch_unwind(AssertUnwindSafe(move || call(args)));
            let time_us = start.elapsed().as_micros() as u64;
            let (printed, truncated) = cap_handle.map(capture::end).unwrap_or_default();

            match result {
                Ok(value) => {
                    let mut json = String::new();
                    match value.write_json(&mut json) {
                        Ok(()) => body.push_str(&format!(",\"status\":\"ok\",\"value\":{json}")),
{% if uses_nodes %}
                        Err(e) => {
                            let (code, text) = node_error(e);
                            let mut err = String::new();
                            write_str(&mut err, &text);
                            body.push_str(&format!(
                                ",\"status\":\"error\",\"error_code\":\"{code}\",\"error\":{err}"
                            ));
                        }
{% else %}
                        Err(e) => {
                            let mut err = String::new();
                            write_str(&mut err, &format!("return value cannot be converted to JSON: {e}"));
                            body.push_str(&format!(
                                ",\"status\":\"error\",\"error_code\":\"return_not_serializable\",\"error\":{err}"
                            ));
                        }
{% endif %}
                    }
                }
                Err(_) => {
                    let msg = PANIC
                        .lock()
                        .ok()
                        .and_then(|mut s| s.take())
                        .unwrap_or_else(|| "panicked".into());
                    let mut err = String::new();
                    write_str(&mut err, &msg);
                    body.push_str(&format!(
                        ",\"status\":\"error\",\"error_code\":\"exception\",\"error\":{err}"
                    ));
                }
            }
            let mut stdout = String::new();
            write_str(&mut stdout, &printed);
            body.push_str(&format!(
                ",\"time_us\":{time_us},\"stdout\":{stdout},\"stdout_truncated\":{truncated}"
            ));
            emit(body);
        }
        emit("\"kind\":\"done\"".into());
    }
