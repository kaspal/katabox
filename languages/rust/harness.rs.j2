            // Debug keeps a fractional part (2.0, not 2) and uses JSON-compatible exponents.
            out.push_str(&format!("{self:?}"));
            Ok(())
        }
    }

    impl ToJson for bool {
        fn write_json(&self, out: &mut String) -> Result<(), String> {
            out.push_str(if *self { "true" } else { "false" });
            Ok(())
        }
    }

    impl ToJson for String {
        fn write_json(&self, out: &mut String) -> Result<(), String> {
            write_str(out, self);
            Ok(())
        }
    }

    impl<T: ToJson> ToJson for Vec<T> {
        fn write_json(&self, out: &mut String) -> Result<(), String> {
            out.push('[');
            for (i, v) in self.iter().enumerate() {
                if i > 0 {
                    out.push(',');
                }
                v.write_json(out)?;
            }
            out.push(']');
            Ok(())
        }
    }

    // ---- Per-test output capture ----------------------------------------------------

    #[cfg(windows)]
    mod capture {
        use std::fs::File;
        use std::io::{Read, Write};
        use std::os::windows::io::FromRawHandle;
        use std::thread::JoinHandle;

        type Handle = *mut core::ffi::c_void;
        const STD_OUTPUT_HANDLE: u32 = -11i32 as u32;
        const STD_ERROR_HANDLE: u32 = -12i32 as u32;

        #[link(name = "kernel32")]
        unsafe extern "system" {
            fn GetStdHandle(id: u32) -> Handle;
            fn SetStdHandle(id: u32, handle: Handle) -> i32;
            fn CreatePipe(read: *mut Handle, write: *mut Handle, attrs: *mut core::ffi::c_void, size: u32) -> i32;
            fn CloseHandle(handle: Handle) -> i32;
        }

        /// The process's stdout at startup, where records go.
        pub fn real_stdout() -> File {
            // SAFETY: the handle is the process's own stdout; the File is leaked by the
            // caller (never closed) so the handle stays valid.
            unsafe { File::from_raw_handle(GetStdHandle(STD_OUTPUT_HANDLE)) }
        }

        pub struct Capture {
            out: Handle,
            err: Handle,
            write: Handle,
            reader: JoinHandle<(String, bool)>,
        }

        /// Point stdout and stderr at a fresh pipe; a thread keeps up to `cap` bytes.
        pub fn begin(cap: usize) -> Option<Capture> {
            let (mut read, mut write): (Handle, Handle) = (std::ptr::null_mut(), std::ptr::null_mut());
            // SAFETY: plain Win32 calls with valid out-pointers; the read end is owned by
            // the File in the reader thread, the write end is closed in `end`.
            unsafe {
                if CreatePipe(&mut read, &mut write, std::ptr::null_mut(), 0) == 0 {
                    return None;
                }
                let read = File::from_raw_handle(read);
                let reader = std::thread::spawn(move || drain(read, cap));
                let out = GetStdHandle(STD_OUTPUT_HANDLE);
                let err = GetStdHandle(STD_ERROR_HANDLE);
                SetStdHandle(STD_OUTPUT_HANDLE, write);
                SetStdHandle(STD_ERROR_HANDLE, write);
                Some(Capture { out, err, write, reader })
            }
        }

        fn drain(mut read: File, cap: usize) -> (String, bool) {
            let (mut kept, mut truncated) = (Vec::new(), false);
            let mut buf = [0u8; 8192];
            while let Ok(n) = read.read(&mut buf) {
                if n == 0 {
                    break;
                }
                let room = cap.saturating_sub(kept.len());
                if n > room {
                    truncated = true;
                }
                kept.extend_from_slice(&buf[..n.min(room)]);
            }
            (String::from_utf8_lossy(&kept).into_owned(), truncated)
        }

        /// Flush, restore stdout and stderr, and collect what the test printed.
        pub fn end(c: Capture) -> (String, bool) {
            let _ = std::io::stdout().flush();
            let _ = std::io::stderr().flush();
            // SAFETY: restores the handles saved in `begin` and closes our write end,
            // which ends the reader thread's loop.
            unsafe {
                SetStdHandle(STD_OUTPUT_HANDLE, c.out);
                SetStdHandle(STD_ERROR_HANDLE, c.err);
                CloseHandle(c.write);
            }
            c.reader.join().unwrap_or_default()
        }
    }

