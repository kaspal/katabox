    impl FromJson for Option<Box<ListNode>> {
        fn from_json(v: &Json) -> Result<Self, String> {
            let Json::Arr(items) = v else {
                return Err(format!("expected a ListNode (an array of integers), got {v:?}"));
            };
            let mut head: Option<Box<ListNode>> = None;
            for item in items.iter().rev() {
                let mut node = Box::new(ListNode::new(i64::from_json(item)?));
                node.next = head;
                head = Some(node);
            }
            Ok(head)
        }
    }

    // Node values take the generic path: read as `Json`, then converted as above.
    impl ReadJson for Option<Box<ListNode>> {
        fn read(p: &mut Parser<'_>) -> Result<Self, ReadError> {
            let v = p.value()?;
            FromJson::from_json(&v).map_err(|_| ReadError::Mismatch)
        }
    }

    impl ToJson for Option<Box<ListNode>> {
        fn write_json(&self, out: &mut String) -> Result<(), String> {
            out.push('[');
            let mut cur = self.as_deref();
            let mut n = 0usize;
            while let Some(node) = cur {
                if n >= NODE_LIMIT {
                    return Err(format!(
                        "node_limit: the returned list has more than {NODE_LIMIT} nodes"
                    ));
                }
                if n > 0 {
                    out.push(',');
                }
                node.val.write_json(out)?;
                n += 1;
                cur = node.next.as_deref();
            }
            out.push(']');
            Ok(())
        }
    }

