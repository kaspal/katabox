    pub trait ToJson {
        /// Appends this value as JSON; fails for values JSON cannot represent.
        fn write_json(&self, out: &mut String) -> Result<(), String>;
    }

    impl ToJson for i64 {
        fn write_json(&self, out: &mut String) -> Result<(), String> {
            out.push_str(&self.to_string());
            Ok(())
        }
    }

    impl ToJson for f64 {
        fn write_json(&self, out: &mut String) -> Result<(), String> {
            if !self.is_finite() {
                return Err(format!("{self} is not a finite number"));
