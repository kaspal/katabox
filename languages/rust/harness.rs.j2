{% if uses_tree %}
    impl FromJson for Option<Rc<RefCell<TreeNode>>> {
        fn from_json(v: &Json) -> Result<Self, String> {
            let Json::Arr(items) = v else {
                return Err(format!("expected a TreeNode (a level-order array), got {v:?}"));
            };
            let nodes = items
                .iter()
                .map(|item| match item {
                    Json::Null => Ok(None),
                    _ => Ok(Some(Rc::new(RefCell::new(TreeNode::new(i64::from_json(item)?))))),
                })
                .collect::<Result<Vec<Option<Rc<RefCell<TreeNode>>>>, String>>()?;
            let mut i = 1;
            for parent in &nodes {
                if i >= nodes.len() {
                    break;
                }
                let Some(p) = parent else { continue };
                p.borrow_mut().left = nodes[i].clone();
                i += 1;
                if i < nodes.len() {
                    p.borrow_mut().right = nodes[i].clone();
                    i += 1;
                }
            }
            Ok(nodes.into_iter().next().flatten())
        }
    }

    impl ReadJson for Option<Rc<RefCell<TreeNode>>> {
        fn read(p: &mut Parser<'_>) -> Result<Self, ReadError> {
            let v = p.value()?;
            FromJson::from_json(&v).map_err(|_| ReadError::Mismatch)
        }
    }

    impl ToJson for Option<Rc<RefCell<TreeNode>>> {
        fn write_json(&self, out: &mut String) -> Result<(), String> {
            let mut items: Vec<Option<i64>> = Vec::new();
            let mut seen = std::collections::HashSet::new();
            let mut queue = std::collections::VecDeque::new();
            if self.is_some() {
                queue.push_back(self.clone());
            }
            while let Some(slot) = queue.pop_front() {
                let Some(node) = slot else {
                    items.push(None);
                    continue;
                };
                if !seen.insert(Rc::as_ptr(&node)) {
                    return Err("node_cycle: the returned tree reaches the same node twice (a cycle or a shared node)".into());
                }
                if seen.len() > NODE_LIMIT {
                    return Err(format!(
                        "node_limit: the returned tree has more than {NODE_LIMIT} nodes"
                    ));
                }
                let n = node
                    .try_borrow()
                    .map_err(|_| "a tree node is still borrowed".to_string())?;
                items.push(Some(n.val));
                queue.push_back(n.left.clone());
                queue.push_back(n.right.clone());
            }
            while items.last() == Some(&None) {
                items.pop();
            }
            out.push('[');
            for (i, item) in items.iter().enumerate() {
                if i > 0 {
                    out.push(',');
                }
                match item {
                    Some(v) => v.write_json(out)?,
                    None => out.push_str("null"),
                }
            }
            out.push(']');
            Ok(())
        }
    }

