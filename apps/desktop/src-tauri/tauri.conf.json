{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KataBox",
  "version": "1.0.0-beta.1",
  "identifier": "dev.katabox.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "KataBox",
        "visible": false,
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600
      },
      {
        "label": "splash",
        "title": "KataBox",
        "url": "splash.html",
        "create": false,
        "width": 640,
        "height": 400,
        "decorations": false,
        "resizable": false,
        "center": true,
        "skipTaskbar": true,
        "visible": true,
        "focus": false,
        "shadow": true,
        "backgroundColor": "#0b0d14"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi",
      "deb",
      "rpm",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/content.db": "content.db",
      "resources/THIRD_PARTY_NOTICES.txt": "THIRD_PARTY_NOTICES.txt"
    },
    "category": "DeveloperTool",
    "shortDescription": "Offline coding practice: problems, tests, editor and debugger",
    "longDescription": "KataBox is a free, open-source desktop app for coding practice. Solve original problems in Python, JavaScript/TypeScript, PHP and Rust; your code runs locally in a sandbox and is judged against public and hidden tests. Works offline.",
    "publisher": "KataBox contributors",
    "copyright": "Copyright © 2026 Ehrlichmann Casas and KataBox contributors",
    "homepage": "https://github.com/kaspal/katabox",
    "license": "MIT OR Apache-2.0",
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English", "Spanish"],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "sidebarImage": "windows/sidebar.bmp",
        "headerImage": "windows/header.bmp",
        "uninstallerHeaderImage": "windows/header.bmp",
        "installerHooks": "windows/hooks.nsh"
      },
      "wix": {
        "version": "0.99.1",
        "language": ["en-US", "es-ES"],
        "fragmentPaths": ["windows/cleanup.wxs"],
        "componentGroupRefs": ["KbUninstallCleanup"]
      }
    }
  }
}
